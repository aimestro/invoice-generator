{
  "name": "invoice-generator",
  "version": "1.0.0",
  "description": "Cross-platform invoice generator: timesheets, clients, ABN/TFN, GST, PDF/Excel/PNG export",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "npm run build && npm start",
    "reset-password": "node server/reset-password.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "knex": "^3.1.0",
    "mysql2": "^3.11.0",
    "pdfkit": "^0.17.1",
    "pg": "^8.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "sharp@0.33.5": true,
    "esbuild@0.21.5": true
  }
}
